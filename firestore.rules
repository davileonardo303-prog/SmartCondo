rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Allow read/write for all application collections in preview/multi-device setup
    match /usuariosSistema/{usuarioId} {
      allow read, write: if true;
    }

    match /condominios/{condominioId} {
      allow read, write: if true;

      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /cobrancas/{cobrancaId} {
      allow read, write: if true;
    }

    match /planosConfig/{planoId} {
      allow read, write: if true;
    }

    match /admins/{adminId} {
      allow read, write: if true;
    }

    match /test/{testId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}


