rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'davileonardo303@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Usuários do Sistema (SuperAdmin, Síndicos, Portaria)
    match /usuariosSistema/{usuarioId} {
      allow read, write: if true;
    }

    // Condomínios e todas as subcoleções
    match /condominios/{condominioId} {
      allow read, write: if true;

      // Moradores
      match /moradores/{moradorId} {
        allow read, write: if true;
      }

      // Bicicletas
      match /bikes/{bikeId} {
        allow read, write: if true;
      }

      // Encomendas
      match /encomendas/{encomendaId} {
        allow read, write: if true;
      }

      // Áreas de Lazer
      match /areasLazer/{areaId} {
        allow read, write: if true;
      }

      // Reservas
      match /reservas/{reservaId} {
        allow read, write: if true;
      }

      // Avisos
      match /avisos/{avisoId} {
        allow read, write: if true;
      }

      // Locações de Bicicletas
      match /locacoes/{locacaoId} {
        allow read, write: if true;
      }

      // Notificações
      match /notificacoes/{notificacaoId} {
        allow read, write: if true;
      }
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Test doc for connection health check
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}

